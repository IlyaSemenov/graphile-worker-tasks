{
  "name": "graphile-worker-tasks",
  "type": "module",
  "version": "2.5.0",
  "packageManager": "bun@1.4.3",
  "description": "Organize and collect graphile-worker tasks",
  "author": "Ilya Semenov",
  "license": "MIT",
  "homepage": "https://github.com/IlyaSemenov/graphile-worker-tasks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/graphile-worker-tasks.git"
  },
  "bugs": "https://github.com/IlyaSemenov/graphile-worker-tasks/issues",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.cts"
      ]
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build",
    "build": "tsdown",
    "lint": "eslint --fix .",
    "test": "bun test",
    "types": "tsc && tsc -p tests/global-tasks"
  },
  "peerDependencies": {
    "graphile-worker": ">=0.12"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@ilyasemenov/eslint-config": "^1.5.2",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.4.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "eslint": "^9.39.4",
    "graphile-worker": "^0.18.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3"
  }
}
